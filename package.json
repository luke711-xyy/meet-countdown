{
  "name": "meet-countdown",
  "version": "1.0.0",
  "private": true,
  "description": "A private, local-first countdown for the next time you meet.",
  "type": "module",
  "scripts": {
    "start": "node --no-warnings server.mjs",
    "dev": "node --watch --no-warnings server.mjs",
    "dev:cloudflare": "wrangler dev --local --port 8787",
    "types": "wrangler types src/worker-configuration.d.ts",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy --minify"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "three": "^0.185.1",
    "three-html-render": "^0.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
}
